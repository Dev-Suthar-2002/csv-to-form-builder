# Applies to the whole repo (seed/ and web/ also have their own .gitignore files).

# --- Secrets & credentials ---
# Environment files (MongoDB connection strings live here)
.env
.env.*
!.env.example
# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
# Cloud / service credential files
credentials.json
service-account*.json
*.secret
secrets/

# --- Database dumps (may contain real customer data) ---
*.dump
*.bson
dump/

# --- Dependencies & build output ---
node_modules/
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- OS & editor files ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Deployment ---
.vercel
